# Kopieer dit bestand naar .env en vul je token in.
#   cp .env.example .env

# Sanity-project "Wandilo test" (geen geheim, mag in git)
NEXT_PUBLIC_SANITY_PROJECT_ID="no1wfx74"
NEXT_PUBLIC_SANITY_DATASET="production"

# API-token, aanmaken op:
# https://www.sanity.io/organizations/oieU862NK/project/no1wfx74/api
# - Voor `npm run seed` heeft het token Editor-rechten nodig.
# - Voor live preview (drafts) is een Viewer-token voldoende; je mag
#   hieronder ook 2x hetzelfde Editor-token gebruiken voor de demo.
SANITY_API_TOKEN=""
SANITY_API_READ_TOKEN=""
